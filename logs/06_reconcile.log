165  /* =========================================================================
166     SECTION 1: Column presence and type checks (D-01, D-02, D-03, D-04, MRG-05)
167     Uses dictionary.columns with libname='G' and upcase(memname)='MASTER_DATA_MERGED'.
168     %macro assert_col aborts loudly on absence -- that is a real finding, not a defect.
169     Each %put on success contains "PASS" so `grep -c "PASS" logs/06_reconcile.log`
170     returns at least 18.
171  
172     R2: assert_col now optionally checks type. Pass type=num or type=char to
173     assert; omit to check presence only. dictionary.columns.type holds 'num' or
174     'char'. Catching a type surprise here, with a clear message, beats a PROC SQL
175     data-type error three sections downstream.
176     ========================================================================= */
177  
178  %macro assert_col(lib=, dsn=, col=, label=, type=);
179    %local n actual;
180    proc sql noprint;
181      select count(*) into :n trimmed
182      from dictionary.columns
183      where libname = upcase("&lib")
184        and upcase(memname) = upcase("&dsn")
185        and upcase(name) = upcase("&col");
186    quit;
187    %if &n = 0 %then %do;
188      %put ERROR: &label -- &col absent from &lib..&dsn -- PRESENCE CHECK FAILED;
189      %abort cancel;
190    %end;
191  
192    %if %superq(type) ne %then %do;
193      proc sql noprint;
194        select type into :actual trimmed
195        from dictionary.columns
196        where libname = upcase("&lib")
197          and upcase(memname) = upcase("&dsn")
198          and upcase(name) = upcase("&col");
199      quit;
200      %if %upcase(&actual) ne %upcase(&type) %then %do;
201        %put ERROR: &label -- &col is type &actual but &type was expected -- TYPE CHECK FAILED;
202        %put ERROR: Downstream comparisons assume &type.. Fix the expectation or the column.;
203        %abort cancel;
204      %end;
205      %put NOTE: &label PASS -- &col present in &lib..&dsn (type &actual);
206    %end;
207    %else %put NOTE: &label PASS -- &col present in &lib..&dsn;
208  %mend assert_col;
