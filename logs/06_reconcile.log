432  /* =========================================================================
433     SECTION 3b: Populated check for six deliberate columns
434     Presence confirms a column EXISTS; it does not confirm that anything landed
435     in it. A broken keep list or stale merge produces a column that is present
436     and entirely missing. SECTION 1 cannot see this.
437  
438     R1: this section previously promised to "flag loudly" and then only printed
439         counts -- a zero looked identical to 41,150. %flag_if_zero now emits
440         WARNING lines, sets &pop_status, and the summary carries the verdict.
441         Still not an %abort: an empty column is a real finding to report, not a
442         reason to withhold the rest of the QC output.
443     R5: every count is reported against &n_total.
444     ========================================================================= */
445  proc sql noprint;
446    select coalesce(sum(Death_Date_Y_N        is not missing), 0),
447           coalesce(sum(IsDead_Y_N            is not missing), 0),
448           coalesce(sum(Death                 is not missing), 0),
449           coalesce(sum(Feels_Exausted        is not missing), 0),
450           coalesce(sum(Feels_Exausted_Value  is not missing), 0),
451           coalesce(sum(ISO_SEV_MAC_TOTAL_Exp is not missing), 0)
