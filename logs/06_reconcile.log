350  /* =========================================================================
351     SECTION 3: rt_envelope_flag distribution (MRG-05 / PCM-D-08)
352     Report 0, 1, missing, and other. Do NOT assert n_flag1 = 9 -- this is a
353     pipeline observation, not an invariant.
354     (RESEARCH Pitfall 4; QC-06 already asserts zero UNFLAGGED violations.)
355  
356     R2: comparison goes through PUT() so it is correct whether the column is
357         numeric or character. The previous `rt_envelope_flag = 0` assumed numeric;
358         PROC SQL raises a data-type error on a character column rather than
359         converting, which would have killed the step.
360     R3: the WHERE ... IS NOT MISSING is gone. It removed missing rows from the
361         denominator without reporting them, so a flag populated only on violating
362         rows would have printed "0 at 0, 9 at 1" with no sign that the rest of the
363         table was excluded.
364     ========================================================================= */
365  proc sql noprint;
366    select coalesce(sum(rt_envelope_flag is not missing
367                        and strip(put(rt_envelope_flag, best.)) = '0'), 0),
368           coalesce(sum(rt_envelope_flag is not missing
369                        and strip(put(rt_envelope_flag, best.)) = '1'), 0),
370           coalesce(sum(missing(rt_envelope_flag)), 0),
371           coalesce(sum(rt_envelope_flag is not missing
372                        and strip(put(rt_envelope_flag, best.)) not in ('0','1')), 0)
373      into :n_flag0     trimmed,
374           :n_flag1     trimmed,
375           :n_flag_miss trimmed,
376           :n_flag_oth  trimmed
377    from g.master_data_merged;
378  quit;
