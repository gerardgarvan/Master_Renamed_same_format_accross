281  /* =========================================================================
282     SECTION 2: Emergent distribution (D-04 / REC-04)
283     Emergent is CHARACTER $1 (md3-owned; Phase 4 LENGTH block). Values are Y/N/blank.
284     NOT 1/0 -- using '1'/'0' returns 0 for both counts (PCM-F-06 established this).
285     Guard applied: IS NOT MISSING before comparison (PCM-T-11).
286     Report counts only; assert NOTHING about the Y/N split (no expected value for
287     the merged md3-owned column).
288  
289     R4: an "other" bucket now catches any value that is neither Y, N, nor blank.
290         Previously such a value fell into no category and the three counts
291         silently failed to sum to N while being presented as exhaustive.
292     R6: coalesce(sum(...), 0) so an empty result reports 0, not ".".
293     ========================================================================= */
294  proc sql noprint;
295    select coalesce(sum(Emergent is not missing and upcase(strip(Emergent)) = 'Y'), 0),
296           coalesce(sum(Emergent is not missing and upcase(strip(Emergent)) = 'N'), 0),
297           coalesce(sum(missing(Emergent)), 0),
298           coalesce(sum(Emergent is not missing
299                        and upcase(strip(Emergent)) not in ('Y','N')), 0)
300      into :n_emergent_y    trimmed,
301           :n_emergent_n    trimmed,
302           :n_emergent_miss trimmed,
303           :n_emergent_oth  trimmed
304    from g.master_data_merged;
305  quit;
