453           :n_pop_id  trimmed,
454           :n_pop_dt  trimmed,
455           :n_pop_fe  trimmed,
456           :n_pop_fev trimmed,
457           :n_pop_iso trimmed
458    from g.master_data_merged;
459  quit;
