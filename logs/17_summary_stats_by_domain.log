2562      select a.varnum, a.varname, a.vtype, a.vlen, a.sas_label,
2563             d.dict_name, d.dict_type, d.description, d.sheet, d.sas_name,
2564             case when a.var_u = upcase(d.sas_name) then 'EXACT'
2565                  else 'SQUASH' end as match_how length=8,
2566             case when a.var_u = upcase(d.sas_name) then 1
2567                  else 3 end as match_rank
2568      from work.actual_ext as a
2569      inner join work.dict_u as d
2570        on a.var_u = upcase(d.sas_name)
2571           or compress(a.var_u,'_') = compress(upcase(d.sas_name),'_');
