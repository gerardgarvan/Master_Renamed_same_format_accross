1919  
1920  %macro scan_sentinels;
1921    %local n_num n_chr;
1922    %let n_num = %sysfunc(countw(&sent_num_all));
1923    %let n_chr = %sysfunc(countw(&sent_chr_all));
1924  
1925    %if &n_num = 0 and &n_chr = 0 %then %do;
1926      data work.sentinel_applicable;
1927        length varname $32 sentinel_kind $10 n_sentinel 8;
1928        stop;
1929      run;
1930      %put WARNING: [17-discovery] g.analysis_base has no columns to scan for sentinels.;
1931    %end;
1932    %else %do;
1933      data work.sentinel_applicable(keep=_vn _sk _ns
1934                                    rename=(_vn=varname _sk=sentinel_kind _ns=n_sentinel));
1935        length _vn $32 _sk $10 _ns 8;
1936        set g.analysis_base end=_eof;
1937  
1938        %if &n_num > 0 %then %do;
1939          array _sn {*} &sent_num_all;
1940          array _cn {&n_num} _temporary_;
1941          do _i = 1 to dim(_sn);
1942            if _sn{_i} = -999 then _cn{_i} + 1;
1943          end;
1944        %end;
1945  
1946        %if &n_chr > 0 %then %do;
1947          array _sc {*} &sent_chr_all;
1948          array _cc {&n_chr} _temporary_;
1949          do _j = 1 to dim(_sc);
1950            if upcase(strip(_sc{_j})) = 'NULL' then _cc{_j} + 1;
1951          end;
1952        %end;
1953  
1954        if _eof then do;
1955          %if &n_num > 0 %then %do;
1956            do _i = 1 to &n_num;
1957              if _cn{_i} > 0 then do;
1958                _vn = upcase(vname(_sn{_i}));
1959                _sk = 'NUM_-999';
1960                _ns = _cn{_i};
1961                output;
1962              end;
1963            end;
1964          %end;
1965          %if &n_chr > 0 %then %do;
1966            do _j = 1 to &n_chr;
1967              if _cc{_j} > 0 then do;
1968                _vn = upcase(vname(_sc{_j}));
1969                _sk = 'CHAR_NULL';
1970                _ns = _cc{_j};
1971                output;
1972              end;
1973            end;
1974          %end;
1975        end;
1976      run;
1977    %end;
1978  %mend scan_sentinels;
