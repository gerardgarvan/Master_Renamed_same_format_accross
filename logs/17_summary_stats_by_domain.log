1904  /* ---- 7. SENTINEL APPLICABILITY ----------------------------------------- */
1905  /* Single pass with arrays. The previous per-variable PROC SQL loop made    */
1906  /* roughly one network read per column against the P: drive.               */
1907  /* Output name and values match what Wave 2 (Section 5) will read:          */
1908  /*   work.sentinel_applicable, sentinel_kind in NUM_-999 / CHAR_NULL        */
1909  /* Wave 2 keeps its own work.sentinel_log for recode counts -- do not       */
1910  /* reuse that name here.                                                    */
1911  %let sent_num_all = ;
1912  %let sent_chr_all = ;
1913  proc sql noprint;
1914    select name into :sent_num_all separated by ' '
1915    from work.cols_base where vtype = 'num';
1916    select name into :sent_chr_all separated by ' '
1917    from work.cols_base where vtype = 'char';
1918  quit;
NOTE: PROCEDURE SQL used (Total process time):
