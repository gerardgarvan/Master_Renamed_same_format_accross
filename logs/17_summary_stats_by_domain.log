2724  /* =========================================================================
2725     SECTION 3b: Identifier exclusion (BEFORE domain assignment)
2726     -------------------------------------------------------------------------
2727     Identifiers and technical keys must never reach statistics: a character
2728     ID routed to PROC FREQ yields a table with tens of thousands of levels.
2729  
2730     CARDINALITY IS NOT AN EXCLUSION CRITERION. The previous version also
2731     excluded any character variable with more than 200 levels, which silently
2732     removed CPT_CODE, PROCEDURE_NAME and ZIP_CODE -- all of which are in the
2733     Section 4 domain lookup. Because the lookup join is scoped to rows that
2734     are not already OUT_OF_SCOPE, the domain assignment could not rescue
2735     them and every guard still passed. Cardinality is now a review flag
2736     carried on n_levels for Checkpoint 1.
2737     ========================================================================= */
2738  
2739  data work.domain_staging3;
2740    set work.domain_staging3;
2741    length hi_cardinality_flag $3;
2742  
2743    if domain = '' then do;
2744      if varname in ('PRECEDE_STUDY_ID','PRECEDE_STUDY_ID_1',
2745                     'ENCRYPTED_MRN','ENCRYPTED_ENCOUNTER')
2746         or prxmatch('/(^|_)(ID|MRN)(_|$)/', strip(upcase(varname))) > 0
2747      then do;
2748        domain           = 'OUT_OF_SCOPE';
2749        domain_rationale = 'identifier or technical key; not an analytic variable';
2750        assign_rule      = 'identifier_exclusion';
2751      end;
2752    end;
2753  
2754    /* Review flag only -- never an exclusion */
2755    if vtype = 'char' and n_levels > 200 then hi_cardinality_flag = 'YES';
2756    else hi_cardinality_flag = 'NO';
2757  run;

