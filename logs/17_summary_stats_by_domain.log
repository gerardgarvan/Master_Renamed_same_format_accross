2230  /* ---- 5. Normalise the extension key, choosing the format empirically --- */
2231  /* The sampled values in the discovery report tell the reviewer what the    */
2232  /* keys look like, but the program must not depend on anyone eyeballing     */
2233  /* them. When the merged key is numeric, both candidate representations are */
2234  /* tested against the base keys and the one that actually matches is used.  */
2235  /* best12. gives 123456789 and z12. gives 000123456789 -- picking wrong     */
2236  /* yields a join that matches nothing while the row count still passes.     */
2237  %macro build_ext_cols(fmt=);
2238    data work.merged_ext_cols;
2239      set g.master_data_merged (keep=PRECEDE_STUDY_ID &extension_keep_list);
2240      length _key_c $&key_norm_len;
2241      if missing(PRECEDE_STUDY_ID) then delete;
2242      %if &key_type_merged = num %then %do;
2243        %if &fmt = Z %then %do;
2244          _key_c = put(PRECEDE_STUDY_ID, z12.);
2245        %end;
2246        %else %do;
2247          _key_c = strip(put(PRECEDE_STUDY_ID, best12.));
2248        %end;
2249      %end;
2250      %else %do;
2251        _key_c = strip(PRECEDE_STUDY_ID);
2252      %end;
2253      drop PRECEDE_STUDY_ID;
2254      rename _key_c = PRECEDE_STUDY_ID;
2255    run;
2256  %mend build_ext_cols;
