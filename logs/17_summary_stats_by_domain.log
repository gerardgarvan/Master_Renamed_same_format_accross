1837  /* ---- 5. EXTENSION COLUMN LIST (D-01 KEEP=) ----------------------------- */
1838  /* Columns in g.master_data_merged NOT in g.analysis_base, filtered to      */
1839  /* frailty, cognitive, and intraop-physiologic concepts. MAC is matched by  */
1840  /* an anchored pattern only -- a bare index for MAC hits PHARMACY, STOMACH. */
1841  /* NOTE: this concept filter is a heuristic. A frailty, cognitive, or       */
1842  /* intraoperative variable whose name contains none of these fragments will */
1843  /* be missed. The resolved list is written to the discovery report for      */
1844  /* review at Checkpoint 1 -- treat it as a proposal, not an authority.      */
1845  proc sql;
1846    create table work.ext_candidates as
1847      select m.name, m.vtype
1848      from work.cols_merged m
1849      where m.name not in (select name from work.cols_base)
1850        and m.name ne 'PRECEDE_STUDY_ID_1'   /* md6 duplicate -- pitfall 5 */
1851        and (
1852              index(m.name,'FRAIL')          > 0
1853           or index(m.name,'COGNI')          > 0
1854           or index(m.name,'FEELS')          > 0
1855           or index(m.name,'WEIGHT_LOSS')    > 0
1856           or index(m.name,'GRIP')           > 0
1857           or index(m.name,'WALK')           > 0
1858           or index(m.name,'PHYSICAL_ACTIV') > 0
1859           or index(m.name,'ABP')            > 0
1860           or index(m.name,'BIS_')           > 0
1861           or index(m.name,'NIBP')           > 0
1862           or index(m.name,'MIDAZOLAM')      > 0
1863           or prxmatch('/(^|_)MAC(_|$)/', strip(m.name)) > 0
1864           or index(m.name,'ISO_SEV')        > 0
1865        );
