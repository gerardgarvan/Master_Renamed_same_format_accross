2878  /* Apply the lookup. The ON clause scopes the join to rows that are not     */
2879  /* already OUT_OF_SCOPE, so identifier exclusions are not overridden.       */
2880  proc sql;
2881    create table work.domain_staging4 as
2882      select ds.*,
2883             coalesce(dl.domain,           ds.domain)           as domain_final    length=16,
2884             coalesce(dl.domain_rationale, ds.domain_rationale) as rationale_final length=200,
2885             coalesce(dl.assign_rule,      ds.assign_rule)      as rule_final      length=20
2886      from work.domain_staging3 as ds
2887      left join work.domain_lookup as dl
2888        on upcase(ds.varname) = dl.varname_u
2889       and ds.domain not in ('OUT_OF_SCOPE');
