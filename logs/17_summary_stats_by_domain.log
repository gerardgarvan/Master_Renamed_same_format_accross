2358  /* ---- 9. Per-column extension coverage ---------------------------------- */
2359  /* Computed on work.analysis_base_ext AFTER the join, so the denominator is */
2360  /* the base row count and the figure is meaningful. The previous Section 0b */
2361  /* version counted in g.master_data_merged but divided by the base row      */
2362  /* count, which could exceed 100 percent.                                   */
2363  /* Single pass with arrays, split by type -- a SAS array cannot mix types.  */
2364  %macro ext_coverage;
2365    %local n_en n_ec;
2366    %let n_en = %sysfunc(countw(&ext_num_list));
2367    %let n_ec = %sysfunc(countw(&ext_chr_list));
2368  
2369    data work.ext_coverage(keep=_vn _nm rename=(_vn=varname _nm=n_nonmiss));
2370      length _vn $32 _nm 8;
2371      set work.analysis_base_ext end=_eof;
2372  
2373      %if &n_en > 0 %then %do;
2374        array _en {*} &ext_num_list;
2375        array _kn {&n_en} _temporary_;
2376        do _i = 1 to dim(_en);
2377          if not missing(_en{_i}) then _kn{_i} + 1;
2378        end;
2379      %end;
2380  
2381      %if &n_ec > 0 %then %do;
2382        array _ec {*} &ext_chr_list;
2383        array _kc {&n_ec} _temporary_;
2384        do _j = 1 to dim(_ec);
2385          if not missing(_ec{_j}) then _kc{_j} + 1;
2386        end;
2387      %end;
2388  
2389      if _eof then do;
2390        %if &n_en > 0 %then %do;
2391          do _i = 1 to &n_en;
2392            _vn = upcase(vname(_en{_i}));
2393            _nm = coalesce(_kn{_i}, 0);
2394            output;
2395          end;
2396        %end;
2397        %if &n_ec > 0 %then %do;
2398          do _j = 1 to &n_ec;
2399            _vn = upcase(vname(_ec{_j}));
2400            _nm = coalesce(_kc{_j}, 0);
2401            output;
2402          end;
2403        %end;
2404      end;
2405    run;
2406  
2407    data work.ext_coverage;
2408      set work.ext_coverage;
2409      length coverage_flag $40;
2410      pct_of_base = 100 * n_nonmiss / &n_base_rows;
2411      if pct_of_base < 90 then coverage_flag = 'PARTIAL';
2412      else coverage_flag = 'FULL';
2413    run;
2414  %mend ext_coverage;
2415  %ext_coverage;
