2258  %macro count_key_overlap(into=);
2259    proc sql noprint;
2260      select count(*) into :&into trimmed
2261      from work.merged_ext_cols
2262      where PRECEDE_STUDY_ID in (select PRECEDE_STUDY_ID from work.base_keyed);
2263    quit;
2264  %mend count_key_overlap;
