2284  
2285      %if &n_best = 0 %then %do;
2286        %put WARNING: [17-S1] best12. matched nothing. Testing zero-padded z12.;
2287        %build_ext_cols(fmt=Z);
2288        %count_key_overlap(into=n_z);
